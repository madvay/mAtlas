{
  "name": "mAtlas",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive, source-backed atlas connecting mathematics, physics, and chemistry across fields and scales.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "validate:data": "npm run validate:content",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:content:schema": "node scripts/validate-content.mjs schema",
    "validate:content:references": "node scripts/validate-content.mjs references",
    "validate:content:semantic": "node scripts/validate-content.mjs semantic",
    "validate:content:editorial": "node scripts/validate-content.mjs editorial",
    "validate:content:chemistry": "node scripts/validate-content.mjs chemistry",
    "validate:content:renderer": "node scripts/validate-content.mjs renderer-compatibility",
    "content:build": "node scripts/build-content.mjs",
    "test:content": "npm run content:build && node scripts/test-content.mjs",
    "math:mark": "node scripts/mark-explicit-math.mjs --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs dist",
    "benchmark:renderer": "node scripts/matlas-render-benchmark.mjs",
    "test": "npm run test:content && npm run typecheck && node scripts/test-unit.mjs && npm run build && npm run test:build-output",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "test:unit": "npm run content:build && node scripts/test-unit.mjs",
    "excise-node": "node scripts/excise-node.mjs",
    "test:build-output": "node scripts/test-build-output.mjs",
    "validate:content:share-codec": "node scripts/validate-content.mjs share-codec"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "katex": "^0.18.1"
  },
  "devDependencies": {
    "esbuild-wasm": "0.28.1",
    "puppeteer": "^25.4.0",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "puppeteer": true
  }
}
