{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.madvay.com/content/schema.json",
  "x-matlas-schema-version": "2.1.0",
  "title": "Atlas of Fundamental Concepts data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "fields",
    "domains",
    "layout",
    "edgeTypes",
    "sources",
    "nodes",
    "edges"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "version",
        "description",
        "direction",
        "scope",
        "license",
        "attribution"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "edgeTypeOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "domainOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "defaultField": {
          "type": "string",
          "minLength": 1
        },
        "fieldOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "color",
          "order",
          "field"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "order": {
            "type": "number"
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verticalBands", "domainLanes"],
      "properties": {
        "verticalBands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fields"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "after": { "type": "string", "minLength": 1 },
              "gap": { "type": "number", "minimum": 0 }
            }
          }
        },
        "domainLanes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "levelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalMinimum", "primaryFieldMinima"],
      "properties": {
        "globalMinimum": {
          "$ref": "#/$defs/levelAnchor"
        },
        "primaryFieldMinima": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/levelAnchor"
          }
        }
      }
    },
    "edgeTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "short",
          "description",
          "prerequisiteTraversal",
          "color",
          "endpointLabels"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "$ref": "#/$defs/nonEmptyMathText"
          },
          "prerequisiteTraversal": {
            "enum": [
              "incoming",
              "outgoing",
              "both",
              "none"
            ]
          },
          "enforcePredecessorLevel": {
            "enum": [
              "incoming",
              "outgoing",
              "none",
              "",
              null
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "endpointLabels": {
            "$ref": "#/$defs/endpointLabels"
          },
          "lineStyle": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "activeInDataset": {
            "type": "boolean"
          },
          "defaultVisible": {
            "type": "boolean"
          }
        }
      }
    },
    "citationLegend": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "title",
          "url",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "color",
          "order",
          "path",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "shortLabel": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "order": {
            "type": "number"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "$ref": "#/$defs/nonEmptyMathText"
          }
        }
      }
    }
  },
  "$defs": {
    "levelAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "nodeIds"],
      "properties": {
        "level": {
          "type": "integer"
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mathText": {
      "type": "string",
      "description": "Prose with any inline LaTeX explicitly delimited by $...$."
    },
    "nonEmptyMathText": {
      "allOf": [
        {
          "$ref": "#/$defs/mathText"
        },
        {
          "minLength": 1
        }
      ]
    },
    "mathTextArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mathText"
      }
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "endpointLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "compatibility",
        "output"
      ],
      "properties": {
        "inputs": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "compatibility": {
          "$ref": "#/$defs/nonEmptyMathText"
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "primaryDomain",
        "domains",
        "level",
        "kind",
        "summary",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "primaryDomain": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "level": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "structure",
            "junction"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyMathText"
        },
        "carriers": {
          "$ref": "#/$defs/mathTextArray"
        },
        "data": {
          "$ref": "#/$defs/mathTextArray"
        },
        "axioms": {
          "$ref": "#/$defs/mathTextArray"
        },
        "induces": {
          "$ref": "#/$defs/mathTextArray"
        },
        "notes": {
          "$ref": "#/$defs/mathText"
        },
        "citations": {
          "$ref": "#/$defs/stringArray"
        },
        "combination": {
          "$ref": "#/$defs/combination"
        },
        "primaryField": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "conceptType": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detailSection"
          }
        },
        "root": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "junction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "combination"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "structure"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "combination"
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "type",
        "label",
        "detail",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyMathText"
        },
        "citations": {
          "$ref": "#/$defs/stringArray"
        },
        "overview": {
          "type": "boolean"
        }
      }
    },
    "detailSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "$ref": "#/$defs/mathText"
        },
        "items": {
          "$ref": "#/$defs/mathTextArray"
        }
      },
      "anyOf": [
        {
          "required": [
            "body"
          ]
        },
        {
          "required": [
            "items"
          ]
        }
      ]
    }
  }
}
